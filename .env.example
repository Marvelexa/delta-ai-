# ==============================================================================
# NEXVORA DELTA AI & STOCK ANALYSIS — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION
# ------------------------------------------------------------------------------
PORT=3002
APP_URL="http://localhost:3002"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DELTA EXCHANGE INDIA (Live Crypto Futures Trading)
# ------------------------------------------------------------------------------
# Required for placing live orders on Delta Exchange India (api.india.delta.exchange)
# Not needed if trading in PAPER mode
DELTA_EXCHANGE_API_KEY="your_delta_exchange_api_key_here"
DELTA_EXCHANGE_API_SECRET="your_delta_exchange_api_secret_here"

# ------------------------------------------------------------------------------
# 3. AI / LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary AI model provider (Google Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"

# Opencode / DeepSeek / Nemotron Integration (Optional Fallback)
OPENCODE_API_KEY=""
OPENCODE_API_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL_NAME="nemotron-3-ultra-free"

# NVIDIA NIM AI Integration (Optional Fallback)
NVIDIA_API_KEY=""
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL_NAME="minimaxai/minimax-m2.7"

# ------------------------------------------------------------------------------
# 4. ANGEL ONE SMARTAPI (Indian Stock Market & F&O Live Feeds)
# ------------------------------------------------------------------------------
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_MPIN=""
ANGEL_ONE_TOTP_SECRET=""

# ------------------------------------------------------------------------------
# 5. INTEGRATIONS & DATABASE (Optional)
# ------------------------------------------------------------------------------
# Supabase / CRM (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GitHub Automation (Optional)
GITHUB_TOKEN=""

# Browserless Automation (Optional)
BROWSERLESS_API_KEY=""
